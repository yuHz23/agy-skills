{
  "agy-skills-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 scripts/pretooluse_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "agy-skills-iron-law-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "py -3 scripts/preinv_reminder.py",
        "timeout": 10
      }
    ]
  }
}
